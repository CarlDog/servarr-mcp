# Configure only the apps you actually run. The MCP server registers
# tools for an app only when both URL and API key are set.

# Sonarr (TV)
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# Radarr (movies)
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# Lidarr (music)
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=

# Readarr (books)
READARR_URL=http://localhost:8787
READARR_API_KEY=

# Prowlarr (indexer manager)
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=
