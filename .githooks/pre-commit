#!/usr/bin/env bash
set -euo pipefail

# 1. Secret scan via gitleaks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "ERROR: gitleaks not installed. Install from https://github.com/gitleaks/gitleaks" >&2
  exit 1
fi

echo "Running gitleaks..."
gitleaks protect --staged --redact --config .gitleaks.toml

# Personal-domain email regex shared by the author-identity check and
# the staged-content scan. Generic by design — no specific PII baked
# into a publicly committed hook.
PERSONAL_EMAIL_PATTERN='[A-Za-z0-9._%+-]+@(gmail|outlook|hotmail|yahoo|icloud|me|live|aol)\.[a-z]{2,}'

# 2. Author identity check
# The staged-content scan below doesn't see git metadata, so a
# personal-domain author email can still leak into commit history
# even when file contents are clean. Block it here, before the
# no-staged-files early exit so empty commits are also covered.
echo "Checking git author identity..."

AUTHOR_IDENT=$(git var GIT_AUTHOR_IDENT)
if echo "$AUTHOR_IDENT" | grep -qE "$PERSONAL_EMAIL_PATTERN"; then
  echo "" >&2
  echo "Configured git author identity matches a personal-domain pattern:" >&2
  echo "  $AUTHOR_IDENT" >&2
  echo "" >&2
  echo "Set a GitHub noreply alias for this repo to avoid leaking it:" >&2
  echo "  git config user.email '<numeric-id>+<login>@users.noreply.github.com'" >&2
  echo "" >&2
  echo "Find your numeric id at https://api.github.com/users/<login>." >&2
  exit 1
fi

# 3. Staged-content PII pattern scan
# Catches user-home directory references and personal-domain email
# addresses that often leak into committed content (workstation paths,
# inline author signatures, etc.). Patterns are deliberately generic
# so the hook can be committed publicly without itself containing any
# specific PII.
echo "Running PII pattern check..."

PII_PATTERNS=(
  '[/\\]Users[/\\][A-Za-z0-9._-]+[/\\]'
  '[/\\]home[/\\][A-Za-z0-9._-]+[/\\]'
  "$PERSONAL_EMAIL_PATTERN"
)

# ACMR (not AM): renamed/copied files must be PII-scanned too. A `git mv` of a
# file containing a home path / personal email would otherwise bypass this scan.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED" ]; then
  exit 0
fi

FOUND=0
while IFS= read -r file; do
  [ -z "$file" ] && continue
  for pattern in "${PII_PATTERNS[@]}"; do
    matches=$(git show ":$file" 2>/dev/null | grep -nE "$pattern" || true)
    if [ -n "$matches" ]; then
      if [ "$FOUND" -eq 0 ]; then
        echo "" >&2
        echo "PII patterns detected in staged content:" >&2
        FOUND=1
      fi
      echo "  $file" >&2
      printf '%s\n' "$matches" | head -3 | sed 's/^/    /' >&2
    fi
  done
done <<< "$STAGED"

if [ "$FOUND" -ne 0 ]; then
  echo "" >&2
  echo "Scrub the matches and re-stage. To adjust patterns, edit .githooks/pre-commit." >&2
  exit 1
fi

echo "No PII patterns detected."
