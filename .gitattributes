# All source files normalized to LF in the repo — prettier config has
# endOfLine: "lf", and CI's format:check runs on Linux where committed
# CRLF would fail. Without this, Windows checkouts can silently commit
# CRLF and break CI.
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# OpenAPI spec snapshots come from GitHub raw with LF endings; locking
# them prevents CRLF round-trip noise on Windows checkouts so diffs
# from re-fetching stay reviewable.
docs/specs/*.json text eol=lf
